<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aapka Sarathi Tours & Travel | Calm, Safe India Journeys</title>
<meta name="description" content="Temple yatras, family and group tours across India. Safe, meaningful journeys with local guidance, transparent pricing and personalized support.">
<meta name="keywords" content="India tours, temple yatra, pilgrimage, Varanasi, Char Dham, South India tour, group travel India">
<meta property="og:title" content="Aapka Sarathi Tours & Travel">
<meta property="og:description" content="Calm, safe India journeys — temple yatras, family tours, and group travel with trusted local support.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --saffron: #E8651A;
    --saffron-light: #F5A05A;
    --saffron-dark: #C04A0A;
    --gold: #D4A017;
    --cream: #FDF6EC;
    --cream-dark: #F5E8D0;
    --charcoal: #1C1C1C;
    --warm-gray: #5A4E42;
    --light-gray: #EDE8E0;
    --white: #FFFFFF;
    --green: #2D6A4F;
    --font-display: 'Playfair Display', Georgia, serif;
    --font-body: 'DM Sans', sans-serif;
    --shadow: 0 4px 24px rgba(28,28,28,0.10);
    --shadow-lg: 0 8px 48px rgba(28,28,28,0.16);
    --radius: 16px;
    --radius-sm: 8px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    color: var(--charcoal);
    background: var(--cream);
    line-height: 1.7;
    overflow-x: hidden;
  }

  /* ── HEADER ── */
  header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(253,246,236,0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--cream-dark);
    padding: 0 5vw;
  }
  .header-inner {
    max-width: 1200px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    height: 70px;
  }
  .logo {
    display: flex; align-items: center; gap: 12px; text-decoration: none;
  }
  .logo-icon {
    width: 44px; height: 44px; border-radius: 50%;
    background: linear-gradient(135deg, var(--saffron), var(--gold));
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; flex-shrink: 0;
  }
  .logo-text { display: flex; flex-direction: column; line-height: 1.2; }
  .logo-text span:first-child {
    font-family: var(--font-display); font-weight: 700;
    font-size: 1.1rem; color: var(--saffron-dark);
  }
  .logo-text span:last-child {
    font-size: 0.72rem; color: var(--warm-gray); letter-spacing: 0.05em;
  }
  nav { display: flex; align-items: center; gap: 8px; }
  nav a {
    font-size: 0.88rem; font-weight: 500; color: var(--warm-gray);
    text-decoration: none; padding: 6px 14px; border-radius: 20px;
    transition: all 0.2s;
  }
  nav a:hover { color: var(--saffron); background: var(--cream-dark); }
  .nav-cta {
    background: var(--saffron); color: var(--white) !important;
    padding: 8px 20px !important; border-radius: 24px !important;
    font-weight: 600 !important;
  }
  .nav-cta:hover { background: var(--saffron-dark) !important; color: var(--white) !important; }
  .hamburger { display: none; background: none; border: none; cursor: pointer; padding: 4px; }
  .hamburger span {
    display: block; width: 24px; height: 2px;
    background: var(--charcoal); margin: 5px 0; transition: 0.3s;
    border-radius: 2px;
  }

  /* ── HERO ── */
  .hero {
    min-height: 92vh;
    background: linear-gradient(160deg, #FDF6EC 0%, #F5E8D0 50%, #EDD9B5 100%);
    display: flex; align-items: center;
    padding: 60px 5vw;
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute; top: -100px; right: -100px;
    width: 600px; height: 600px; border-radius: 50%;
    background: radial-gradient(circle, rgba(232,101,26,0.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero::after {
    content: '';
    position: absolute; bottom: -80px; left: -60px;
    width: 400px; height: 400px; border-radius: 50%;
    background: radial-gradient(circle, rgba(212,160,23,0.10) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-inner {
    max-width: 1200px; margin: 0 auto; width: 100%;
    display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(232,101,26,0.10); border: 1px solid rgba(232,101,26,0.25);
    border-radius: 20px; padding: 6px 16px; margin-bottom: 24px;
    font-size: 0.82rem; font-weight: 600; color: var(--saffron-dark);
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  h1 {
    font-family: var(--font-display); font-weight: 900;
    font-size: clamp(2.4rem, 4vw, 3.6rem); line-height: 1.15;
    color: var(--charcoal); margin-bottom: 20px;
  }
  h1 em { font-style: italic; color: var(--saffron); }
  .hero-sub {
    font-size: 1.05rem; color: var(--warm-gray); margin-bottom: 36px;
    max-width: 480px; line-height: 1.8;
  }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 40px; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 28px; border-radius: 30px; font-weight: 600;
    font-size: 0.95rem; text-decoration: none; transition: all 0.25s;
    cursor: pointer; border: none; font-family: var(--font-body);
  }
  .btn-primary {
    background: var(--saffron); color: var(--white);
    box-shadow: 0 4px 20px rgba(232,101,26,0.35);
  }
  .btn-primary:hover { background: var(--saffron-dark); transform: translateY(-2px); box-shadow: 0 8px 28px rgba(232,101,26,0.45); }
  .btn-secondary {
    background: var(--white); color: var(--saffron);
    border: 2px solid var(--saffron);
  }
  .btn-secondary:hover { background: var(--saffron); color: var(--white); transform: translateY(-2px); }
  .btn-whatsapp {
    background: #25D366; color: var(--white);
    box-shadow: 0 4px 20px rgba(37,211,102,0.35);
  }
  .btn-whatsapp:hover { background: #1EB855; transform: translateY(-2px); }
  .hero-trust {
    display: flex; gap: 24px; flex-wrap: wrap;
  }
  .trust-item {
    display: flex; align-items: center; gap: 8px;
    font-size: 0.85rem; color: var(--warm-gray); font-weight: 500;
  }
  .trust-icon { font-size: 1.1rem; }

  /* Hero card */
  .hero-card {
    background: var(--white); border-radius: 24px;
    padding: 32px; box-shadow: var(--shadow-lg);
    border: 1px solid var(--cream-dark);
  }
  .hero-card h3 {
    font-family: var(--font-display); font-size: 1.3rem;
    color: var(--charcoal); margin-bottom: 20px; font-weight: 700;
  }
  .quick-form { display: flex; flex-direction: column; gap: 14px; }
  .quick-form input, .quick-form select, .quick-form textarea {
    width: 100%; padding: 12px 16px;
    border: 1.5px solid var(--light-gray); border-radius: var(--radius-sm);
    font-family: var(--font-body); font-size: 0.9rem; color: var(--charcoal);
    background: var(--cream); transition: border 0.2s; outline: none;
  }
  .quick-form input:focus, .quick-form select:focus, .quick-form textarea:focus {
    border-color: var(--saffron); background: var(--white);
  }
  .quick-form textarea { resize: none; height: 80px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .quick-form .btn-primary { width: 100%; justify-content: center; font-size: 1rem; padding: 15px; }

  /* ── SECTION BASE ── */
  section { padding: 80px 5vw; }
  .section-inner { max-width: 1200px; margin: 0 auto; }
  .section-label {
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--saffron); margin-bottom: 12px;
  }
  h2 {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.6rem); color: var(--charcoal);
    line-height: 1.2; margin-bottom: 16px;
  }
  .section-sub {
    font-size: 1rem; color: var(--warm-gray); max-width: 580px; line-height: 1.8;
  }
  .section-header { margin-bottom: 48px; }
  .section-header.centered { text-align: center; }
  .section-header.centered .section-sub { margin: 0 auto; }

  /* ── WHY US ── */
  .why-us { background: var(--charcoal); }
  .why-us h2, .why-us .section-label { color: var(--cream); }
  .why-us .section-sub { color: #A89C8E; }
  .pillars {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px;
  }
  .pillar {
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.10);
    border-radius: var(--radius); padding: 28px 24px;
    transition: all 0.3s;
  }
  .pillar:hover { background: rgba(232,101,26,0.12); border-color: var(--saffron); transform: translateY(-4px); }
  .pillar-icon { font-size: 2rem; margin-bottom: 16px; }
  .pillar h4 { font-family: var(--font-display); font-size: 1.1rem; color: var(--cream); margin-bottom: 10px; }
  .pillar p { font-size: 0.88rem; color: #A89C8E; line-height: 1.7; }

  /* ── PACKAGES ── */
  .packages { background: var(--white); }
  .packages-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px;
  }
  .pkg-card {
    border-radius: var(--radius); overflow: hidden;
    border: 1px solid var(--light-gray); background: var(--cream);
    transition: all 0.3s; position: relative;
  }
  .pkg-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }
  .pkg-header {
    padding: 28px 24px 20px;
    background: linear-gradient(135deg, var(--saffron), var(--gold));
    position: relative;
  }
  .pkg-tag {
    display: inline-block; font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    background: rgba(255,255,255,0.25); color: var(--white);
    border-radius: 10px; padding: 3px 10px; margin-bottom: 10px;
  }
  .pkg-header h3 {
    font-family: var(--font-display); font-size: 1.3rem;
    color: var(--white); font-weight: 700; margin-bottom: 6px;
  }
  .pkg-header p { font-size: 0.85rem; color: rgba(255,255,255,0.85); }
  .pkg-body { padding: 24px; }
  .pkg-price {
    font-size: 0.85rem; color: var(--saffron-dark); font-weight: 600;
    background: rgba(232,101,26,0.10); border-radius: 8px;
    padding: 8px 12px; margin-bottom: 16px; display: inline-block;
  }
  .pkg-includes { list-style: none; margin-bottom: 20px; }
  .pkg-includes li {
    font-size: 0.85rem; color: var(--warm-gray); padding: 4px 0;
    display: flex; align-items: center; gap: 8px;
  }
  .pkg-includes li::before { content: '✓'; color: var(--green); font-weight: 700; }
  .pkg-body .btn { width: 100%; justify-content: center; }

  /* ── DESTINATIONS ── */
  .destinations { background: var(--cream); }
  .dest-tabs {
    display: flex; gap: 8px; margin-bottom: 36px;
    border-bottom: 2px solid var(--light-gray); padding-bottom: 0;
  }
  .dest-tab {
    padding: 10px 24px; border: none; background: none; cursor: pointer;
    font-family: var(--font-body); font-size: 0.92rem; font-weight: 600;
    color: var(--warm-gray); border-bottom: 3px solid transparent;
    margin-bottom: -2px; transition: all 0.2s;
  }
  .dest-tab.active { color: var(--saffron); border-bottom-color: var(--saffron); }
  .dest-panel { display: none; }
  .dest-panel.active { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; }
  .dest-card {
    background: var(--white); border-radius: var(--radius-sm);
    padding: 20px; border: 1px solid var(--light-gray);
    transition: all 0.25s; cursor: pointer;
  }
  .dest-card:hover { border-color: var(--saffron); box-shadow: 0 4px 16px rgba(232,101,26,0.15); transform: translateY(-2px); }
  .dest-emoji { font-size: 1.8rem; margin-bottom: 10px; }
  .dest-badge {
    font-size: 0.68rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--saffron); margin-bottom: 6px;
  }
  .dest-card h4 { font-family: var(--font-display); font-size: 1rem; color: var(--charcoal); margin-bottom: 6px; }
  .dest-card p { font-size: 0.8rem; color: var(--warm-gray); line-height: 1.6; }

  /* ── YATRAS ── */
  .yatras { background: linear-gradient(135deg, #FDF6EC, #EDD9B5); }
  .yatra-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
  .yatra-circuits { display: flex; flex-direction: column; gap: 16px; }
  .yatra-item {
    background: var(--white); border-radius: var(--radius-sm);
    padding: 20px; border-left: 4px solid var(--saffron);
    box-shadow: 0 2px 12px rgba(28,28,28,0.06);
  }
  .yatra-item h4 { font-family: var(--font-display); font-size: 1rem; color: var(--charcoal); margin-bottom: 6px; }
  .yatra-item p { font-size: 0.83rem; color: var(--warm-gray); line-height: 1.6; }
  .yatra-features { display: flex; flex-direction: column; gap: 14px; }
  .yatra-feat {
    display: flex; gap: 14px; align-items: flex-start;
    background: rgba(255,255,255,0.7); border-radius: var(--radius-sm);
    padding: 16px;
  }
  .feat-icon { font-size: 1.4rem; flex-shrink: 0; }
  .feat-text h5 { font-weight: 600; font-size: 0.92rem; color: var(--charcoal); margin-bottom: 4px; }
  .feat-text p { font-size: 0.82rem; color: var(--warm-gray); line-height: 1.5; }

  /* ── REVIEWS ── */
  .reviews { background: var(--white); }
  .reviews-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  .review-card {
    background: var(--cream); border-radius: var(--radius);
    padding: 28px; border: 1px solid var(--cream-dark);
    position: relative;
  }
  .review-stars { color: var(--gold); font-size: 1rem; margin-bottom: 14px; }
  .review-text { font-size: 0.9rem; color: var(--warm-gray); line-height: 1.75; margin-bottom: 20px; font-style: italic; }
  .review-author { font-size: 0.82rem; font-weight: 600; color: var(--charcoal); }
  .review-tag { font-size: 0.75rem; color: var(--saffron); font-weight: 500; }
  .review-quote {
    position: absolute; top: 20px; right: 24px;
    font-size: 3rem; color: rgba(232,101,26,0.12);
    font-family: Georgia, serif; line-height: 1;
  }

  /* ── FAQ ── */
  .faq { background: var(--cream); }
  .faq-list { display: flex; flex-direction: column; gap: 12px; max-width: 720px; }
  .faq-item {
    background: var(--white); border-radius: var(--radius-sm);
    border: 1px solid var(--light-gray); overflow: hidden;
  }
  .faq-q {
    padding: 18px 20px; font-weight: 600; font-size: 0.92rem;
    color: var(--charcoal); cursor: pointer; display: flex;
    justify-content: space-between; align-items: center; gap: 12px;
    user-select: none;
  }
  .faq-q:hover { color: var(--saffron); }
  .faq-icon { flex-shrink: 0; font-size: 1.2rem; color: var(--saffron); transition: transform 0.3s; }
  .faq-a {
    max-height: 0; overflow: hidden; transition: max-height 0.3s ease;
    font-size: 0.88rem; color: var(--warm-gray); line-height: 1.7;
  }
  .faq-a-inner { padding: 0 20px 18px; }
  .faq-item.open .faq-a { max-height: 300px; }
  .faq-item.open .faq-icon { transform: rotate(45deg); }

  /* ── CONTACT ── */
  .contact { background: var(--saffron); }
  .contact-inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
  }
  .contact h2 { color: var(--white); }
  .contact .section-label { color: rgba(255,255,255,0.7); }
  .contact p { color: rgba(255,255,255,0.85); font-size: 0.95rem; line-height: 1.8; margin-top: 16px; }
  .contact-methods { display: flex; flex-direction: column; gap: 14px; margin-top: 28px; }
  .contact-method {
    display: flex; align-items: center; gap: 14px;
    background: rgba(255,255,255,0.15); border-radius: var(--radius-sm);
    padding: 14px 18px; text-decoration: none;
    transition: all 0.2s; color: var(--white);
  }
  .contact-method:hover { background: rgba(255,255,255,0.25); transform: translateX(4px); }
  .cm-icon { font-size: 1.3rem; }
  .cm-text strong { display: block; font-size: 0.8rem; opacity: 0.75; font-weight: 500; }
  .cm-text span { font-size: 0.95rem; font-weight: 600; }
  .contact-form {
    background: var(--white); border-radius: 20px;
    padding: 36px; box-shadow: var(--shadow-lg);
  }
  .contact-form h3 {
    font-family: var(--font-display); font-size: 1.25rem;
    color: var(--charcoal); margin-bottom: 20px; font-weight: 700;
  }
  .contact-form input, .contact-form select, .contact-form textarea {
    width: 100%; padding: 12px 16px; border: 1.5px solid var(--light-gray);
    border-radius: var(--radius-sm); font-family: var(--font-body);
    font-size: 0.9rem; color: var(--charcoal); background: var(--cream);
    transition: border 0.2s; outline: none; margin-bottom: 14px;
  }
  .contact-form input:focus, .contact-form select:focus, .contact-form textarea:focus {
    border-color: var(--saffron); background: var(--white);
  }
  .contact-form textarea { resize: none; height: 100px; }
  .contact-form .btn-primary { width: 100%; justify-content: center; padding: 15px; font-size: 1rem; }
  .success-msg {
    display: none; background: rgba(45,106,79,0.1); border: 1px solid var(--green);
    color: var(--green); border-radius: var(--radius-sm); padding: 12px 16px;
    font-size: 0.88rem; font-weight: 500; margin-top: 12px; text-align: center;
  }

  /* ── FOOTER ── */
  footer {
    background: #111; color: rgba(255,255,255,0.7);
    padding: 40px 5vw 24px; text-align: center;
  }
  .footer-logo {
    font-family: var(--font-display); font-size: 1.3rem;
    color: var(--cream); margin-bottom: 12px; font-weight: 700;
  }
  .footer-tagline { font-size: 0.85rem; margin-bottom: 20px; }
  .footer-links { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-bottom: 24px; }
  .footer-links a { color: rgba(255,255,255,0.6); text-decoration: none; font-size: 0.85rem; transition: color 0.2s; }
  .footer-links a:hover { color: var(--saffron); }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px; font-size: 0.78rem; color: rgba(255,255,255,0.4); }

  /* ── FLOAT CTA ── */
  .float-cta {
    position: fixed; bottom: 24px; right: 24px; z-index: 200;
    display: flex; flex-direction: column; gap: 10px; align-items: flex-end;
  }
  .float-btn {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 20px; border-radius: 30px; font-weight: 600;
    font-size: 0.88rem; text-decoration: none; box-shadow: var(--shadow-lg);
    transition: all 0.25s;
  }
  .float-wa { background: #25D366; color: var(--white); }
  .float-wa:hover { transform: scale(1.05); box-shadow: 0 8px 32px rgba(37,211,102,0.45); }
  .float-call { background: var(--saffron); color: var(--white); }
  .float-call:hover { transform: scale(1.05); box-shadow: 0 8px 32px rgba(232,101,26,0.45); }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 40px; }
    .hero { min-height: auto; padding: 40px 5vw 60px; }
    .yatra-grid { grid-template-columns: 1fr; }
    .contact-inner { grid-template-columns: 1fr; }
    nav { display: none; }
    .hamburger { display: block; }
    nav.mobile-open {
      display: flex; flex-direction: column;
      position: fixed; top: 70px; left: 0; right: 0;
      background: var(--cream); border-bottom: 1px solid var(--cream-dark);
      padding: 20px 5vw; box-shadow: var(--shadow-lg); z-index: 99;
    }
    .form-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    section { padding: 60px 5vw; }
    .hero-ctas { flex-direction: column; }
    .hero-trust { flex-direction: column; gap: 12px; }
    .packages-grid { grid-template-columns: 1fr; }
  }

  /* ── INSTAGRAM ── */
  .instagram { background: var(--white); }
  .insta-header {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 20px; margin-bottom: 40px;
  }
  .insta-handle {
    display: flex; align-items: center; gap: 14px;
  }
  .insta-avatar {
    width: 56px; height: 56px; border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 0 0 3px var(--white), 0 0 0 5px #e6683c;
  }
  .insta-meta strong {
    display: block; font-size: 1.05rem; font-weight: 700; color: var(--charcoal);
  }
  .insta-meta span { font-size: 0.85rem; color: var(--warm-gray); }
  .btn-insta {
    background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
